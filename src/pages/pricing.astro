---
import { ClosingCta } from '@/components/home/closing-cta'
import { Everything } from '@/components/home/everything'
import { FaqSection } from '@/components/home/faq'
import PricingHero from '@/components/pages/pricing'
import { FeatureTable } from '@/components/pricing/feature-table'
import { Lifetime } from '@/components/pricing/lifetime'
import { PricingPlans } from '@/components/pricing/plans'
import { Section } from '@/components/ui/section'
import { PAGES } from '@/lib/pages'
import Site from '@/src/layouts/Site.astro'
---

<Site meta={PAGES.pricing}>
  <PricingHero />
  <Section className="!pt-10 sm:!pt-12">
    <PricingPlans client:load />
  </Section>
  <Section tone="sunken">
    <FeatureTable client:visible />
  </Section>
  <Everything />
  <Section>
    <Lifetime />
  </Section>
  <FaqSection
    only={[
      'How many items',
      'What plan should I choose',
      'Do I need a credit card',
      'Is there a contract',
      'I have a lifetime deal',
      'Does Subly pay for itself',
      'Does Subly connect to my bank',
    ]}
  />
  <ClosingCta />
</Site>
