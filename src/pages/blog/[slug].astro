---
import BlogPost from '@/components/pages/blog-post'
import { type Post, getPosts } from '@/lib/content'
import { postMeta } from '@/lib/routes'
import Site from '@/src/layouts/Site.astro'

export function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
---

<Site meta={postMeta(post)}>
  <BlogPost post={post} />
</Site>
