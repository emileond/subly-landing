---
import { ComparisonIntro, ComparisonRest } from '@/components/compare/comparison-page'
import { HeadToHead } from '@/components/compare/compare-table'
import { ClosingCta } from '@/components/home/closing-cta'
import { FaqSection } from '@/components/home/faq'
import { Section, SectionHeading } from '@/components/ui/section'
import { CHECKED_SHORT, COMPARISONS, type Comparison, PRODUCTS } from '@/lib/compare'
import { absoluteUrl } from '@/lib/site'
import Site from '@/src/layouts/Site.astro'

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }))
}

const { c } = Astro.props as { c: Comparison }
const them = PRODUCTS[c.competitor]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Compare', item: absoluteUrl('/compare') },
    { '@type': 'ListItem', position: 3, name: c.h1, item: absoluteUrl(c.meta.path) },
  ],
}
---

<Site meta={c.meta} jsonLd={jsonLd}>
  <ComparisonIntro c={c} />
  <Section id="features" className="scroll-mt-16">
    <SectionHeading eyebrow={`Feature by feature · checked ${CHECKED_SHORT}`} title={`Subly and ${them.name}, line by line`} lede="Where a vendor’s own site doesn’t mention something, the table says so instead of guessing." />
    <div class="mt-10">
      <HeadToHead client:load competitor={c.competitor} />
    </div>
  </Section>
  <ComparisonRest c={c} />
  <FaqSection extra={c.faq} only={['How is my data handled']} />
  <ClosingCta title="Try it on your own numbers." body="Upload one statement and see every recurring charge Subly finds, with what renews next and what went up. Then decide." />
</Site>
