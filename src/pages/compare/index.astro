---
import { HubIntro, HubRest } from '@/components/compare/compare-hub'
import { Matrix } from '@/components/compare/compare-table'
import { ClosingCta } from '@/components/home/closing-cta'
import { FaqSection } from '@/components/home/faq'
import { Section, SectionHeading } from '@/components/ui/section'
import { CHECKED_SHORT, COMPARISONS, HUB, PRODUCT_ORDER } from '@/lib/compare'
import { absoluteUrl } from '@/lib/site'
import Site from '@/src/layouts/Site.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Compare', item: absoluteUrl('/compare') },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Subly compared with other subscription trackers',
      itemListElement: COMPARISONS.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.h1, url: absoluteUrl(`/compare/${c.slug}`) })),
    },
  ],
}
---

<Site meta={HUB.meta} jsonLd={jsonLd}>
  <HubIntro />
  <Section id="features" className="scroll-mt-16">
    <SectionHeading eyebrow={`Feature by feature · checked ${CHECKED_SHORT}`} title="All eight, side by side" lede="Where a vendor’s own site doesn’t mention something, the table says so instead of guessing." />
    <div class="mt-10">
      <Matrix client:load ids={PRODUCT_ORDER} />
    </div>
  </Section>
  <HubRest />
  <FaqSection extra={HUB.faq} only={['How is my data handled']} />
  <ClosingCta title="See everything your business pays and gets paid on repeat." body="Upload one statement and Subly lists every recurring charge, what renews next, what went up and what looks forgotten." />
</Site>
